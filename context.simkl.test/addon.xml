<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="context.simkl.test" 
       name="SIMKL - Test Context Menu" 
       version="0.0.3" 
       provider-name="Claude.ai">
    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
    </requires>
    <extension point="kodi.context.item">
        <menu id="kodi.core.main">
            <item library="test.py">
                <label>32000</label>
                <visible>String.IsEqual(ListItem.dbtype,movie) | String.IsEqual(ListItem.dbtype,episode)</visible>
            </item>
        </menu>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary lang="en_GB">SIMKL Test Context Menu</summary>
        <description lang="en_GB">Test context menu for SIMKL integration</description>
        <platform>all</platform>
        <license>MIT</license>
        <assets>
            <icon>icon.png</icon>
        </assets>
    </extension>
</addon>
